---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import GuideCTA from '../components/GuideCTA.astro';
import { getPosts, postUrl } from '../lib/posts';
import { categories, categorySlugs } from '../data/categories';
import { channelUrl, siteDescription } from '../data/site';
import videos from '../data/videos.json';
const posts = await getPosts();
const latest = [...videos].sort((a, b) => b.date.localeCompare(a.date))[0];
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Critical Latitude', url: Astro.site, logo: new URL('/logo.png', Astro.site).href, sameAs: [channelUrl], description: siteDescription };
---
<Base title="The science behind the risks" description={siteDescription} jsonLd={organization}>
  <section class="home-hero topographic"><div class="container"><p class="eyebrow"><span class="status-square" aria-hidden="true"></span> THE RESEARCH. THE RISKS. THE PEOPLE.</p><h1>CRITICAL <span>LATITUDE</span></h1><blockquote>I make videos about earthquakes, volcanoes, tsunamis, glaciers and extreme weather, but most importantly, about the people whose lives sit on top of them.<cite>— Gwen, Critical Latitude</cite></blockquote><div class="hero-actions"><a class="button" href={posts[0] ? postUrl(posts[0]) : '/blog/'}>Read the latest <span aria-hidden="true">↗</span></a><a class="button button-outline" href={channelUrl}>Watch on YouTube ↗</a></div><p class="hero-rule">PUBLISHED RESEARCH · MONITORING DATA · PLAIN ENGLISH</p></div></section>
  {posts[0] && <section class="editorial-section container"><div class="section-title-row"><div><p class="eyebrow">THE LATEST DOSSIER</p><h2>In focus</h2></div><a class="text-link" href="/blog/">All articles ↗</a></div><PostCard post={posts[0]} featured /></section>}
  <section class="editorial-section container" aria-labelledby="recent-title"><div class="section-title-row"><div><p class="eyebrow">FROM THE FIELD NOTES</p><h2 id="recent-title">Recent articles</h2></div></div><div class="post-grid">{posts.slice(0, 6).map(post => <PostCard post={post} />)}</div></section>
  <section class="category-strip"><div class="container"><h2 class="eyebrow">Explore by subject</h2><ul class="category-list">{categorySlugs.map(slug => <li><a href={`/category/${slug}/`}>{categories[slug].name}</a></li>)}</ul></div></section>
  <section class="editorial-section container"><div class="section-title-row"><div><p class="eyebrow">FROM THE CHANNEL</p><h2>Latest video</h2></div><a class="text-link" href="/videos/">Video archive ↗</a></div><div class="latest-video"><a href={`https://www.youtube.com/watch?v=${latest.id}`} aria-label={`Watch ${latest.title}`}><img src={`https://img.youtube.com/vi/${latest.id}/hqdefault.jpg`} width="480" height="360" alt="" loading="lazy" /></a><div><p class="eyebrow">GWEN / {latest.duration}</p><h3>{latest.title}</h3><a class="button button-outline" href={`https://www.youtube.com/watch?v=${latest.id}`}>Watch on YouTube ↗</a></div></div></section>
  <div class="container editorial-section"><GuideCTA /></div>
</Base>
