---
import { categories } from '../data/categories';
import { formatDate, postUrl, readingTime, type Post } from '../lib/posts';
interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
---
<article class:list={['post-card', { 'featured-card': featured }]}>
  <a class="card-image" href={postUrl(post)} tabindex="-1" aria-hidden="true"><img src={`https://img.youtube.com/vi/${post.data.videoId}/hqdefault.jpg`} alt="" width="480" height="360" loading={featured ? 'eager' : 'lazy'} decoding="async" /></a>
  <div class="card-content"><a class="category-label" href={`/category/${post.data.category}/`}>{categories[post.data.category].name}</a>
    {featured ? <h3><a href={postUrl(post)}>{post.data.title}</a></h3> : <h2><a href={postUrl(post)}>{post.data.title}</a></h2>}
    <p>{post.data.description}</p><div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><span>{readingTime(post)} min read</span></div>
    {featured && <a class="text-link" href={postUrl(post)}>Read the article <span aria-hidden="true">↗</span></a>}
  </div>
</article>
